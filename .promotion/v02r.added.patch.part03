+    "end_unit_count",
+    "start_average_unit_health_pct",
+    "end_average_unit_health_pct",
+    "start_force_strength",
+    "end_force_strength",
+    "start_action_points_remaining_pct",
+    "end_action_points_remaining_pct",
+    "wars",
